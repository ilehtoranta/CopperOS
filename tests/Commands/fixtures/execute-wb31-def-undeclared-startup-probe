; Disposable WB 3.1 Execute undeclared .DEF probe. Output is retained in S:Shell-Startup.
FailAt 255
Echo "BEGIN" >RAM:execute-capture
Echo ".KEY filename" >RAM:execute-probe
Echo ".DEF missing fallback" >>RAM:execute-probe
Echo "Echo SHOULD-NOT-RUN >>RAM:execute-capture" >>RAM:execute-probe
C:Execute RAM:execute-probe
Echo "STATUS RC=$RC RESULT2=$Result2" >>RAM:execute-capture
Echo "AFTER" >>RAM:execute-capture
Copy RAM:execute-capture S:Shell-Startup >NIL:
EndCLI >NIL:
