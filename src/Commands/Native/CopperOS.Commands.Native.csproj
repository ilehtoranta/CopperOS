<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compatibility aggregate. Produces the same CopperOS.Commands.Native assembly
    the pre-restructure Native project did, from the new per-command folders:
    Common/, every <Command>/Native/ body, and the portable algorithm files the
    old project linked. The private closure roots and qualifiers
    (tests/Commands.NativeRoot, tests/Commands.NativeExecution,
    tools/Commands/qualify_*.ps1 and the *NativeRoot entry projects) keep
    referencing this project and assembly name unchanged.

    Shipping C: binaries do NOT come from here: each src/Commands/<Command>
    project publishes its own. <Command>/Entry/ is deliberately excluded.
  -->
  <PropertyGroup>
    <AssemblyName>CopperOS.Commands.Native</AssemblyName>
    <RootNamespace>CopperOS.Commands.Native</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Common\*.cs;..\*\Native\*.cs" />
    <Compile Include="..\Eval\EvalExpressionEvaluator.cs;..\Eval\EvalNumericFormatter.cs;..\Eval\EvalLFormatFormatter.cs;..\Eval\EvalClassicLFormatFormatter.cs" />
    <Compile Include="..\Quote\QuoteReadItemFormatter.cs;..\Quote\QuoteHexFormatter.cs;..\Quote\QuoteUriFormatter.cs;..\Quote\QuoteBase64Formatter.cs;..\Quote\QuoteForwardPipeline.cs;..\Quote\QuoteReversePipeline.cs;..\Quote\QuoteRuleParser.cs" />
    <Compile Include="..\Type\TypeTextFormatter.cs" />
    <Compile Include="..\Exe2Arc\Exe2ArcIo.cs;..\Exe2Arc\Exe2ArcPayloadCopy.cs;..\Exe2Arc\Exe2ArcHeaderProbe.cs;..\Exe2Arc\Exe2ArcForwardScanner.cs;..\Exe2Arc\Exe2ArcOutputName.cs;..\Exe2Arc\Exe2ArcOutputSelection.cs;..\Exe2Arc\Exe2ArcTypeSelection.cs;..\Exe2Arc\Exe2ArcScannerSelection.cs;..\Exe2Arc\Exe2ArcResultPolicy.cs;..\Exe2Arc\Exe2ArcLhaScanner.cs;..\Exe2Arc\Exe2ArcZipScanner.cs;..\Exe2Arc\Exe2ArcZipRecordRewriter.cs;..\Exe2Arc\Exe2ArcZipRecordExtractor.cs" />
  </ItemGroup>
</Project>
