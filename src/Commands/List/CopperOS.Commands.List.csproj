<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CopperOS.Commands.List</AssemblyName>
    <RootNamespace>CopperOS.Commands</RootNamespace>
    <RuntimeIdentifier>amiga-m68k</RuntimeIdentifier>
    <CopperOSCommandName>List</CopperOSCommandName>
    <CopperOSCodeSizeOptimizations Condition="'$(CopperOSCodeSizeOptimizations)' == ''">on</CopperOSCodeSizeOptimizations>
    <CopperSharpEntry>CopperOS.Commands.Entries.ListEntry::Main</CopperSharpEntry>
    <DefineConstants Condition="'$(CopperOSSpecializeWorkbench31)' != 'false'">$(DefineConstants);COPPEROS_WORKBENCH31_LIST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\CopperOS.Commands.Common.csproj" />
  </ItemGroup>
</Project>
