<Project>
  <Import Project="$(MSBuildThisFileDirectory)CodeSizePolicies.props" />
  <PropertyGroup>
    <CopperOSCommandVersionsFile Condition="'$(CopperOSCommandVersionsFile)' == ''">$(MSBuildThisFileDirectory)CommandVersions.props</CopperOSCommandVersionsFile>
  </PropertyGroup>
  <Import Project="$(CopperOSCommandVersionsFile)" Condition="Exists('$(CopperOSCommandVersionsFile)')" />
  <!--
    A command project sets CopperOSCommandName (the C: file name) and
    CopperSharpEntry. `dotnet publish` then compiles that one entry to a HUNK
    and copies it to $(CopperOSCDirectory)<CopperOSCommandName>.
  -->
  <PropertyGroup Condition="'$(CopperOSCommandName)' != ''">
    <!-- One C: binary per command: MC68000 runs on every Kickstart 3.1 machine. -->
    <CopperSharpCpu Condition="'$(CopperSharpCpu)' == ''">68000</CopperSharpCpu>
    <CopperSharpOutputFormat>hunk</CopperSharpOutputFormat>
    <!-- Match the qualified native receipts (artifacts/cc10-*): resident, fatal exceptions. -->
    <CopperSharpRuntimeProfile Condition="'$(CopperSharpRuntimeProfile)' == ''">resident</CopperSharpRuntimeProfile>
    <CopperSharpExceptionMode Condition="'$(CopperSharpExceptionMode)' == ''">yolo</CopperSharpExceptionMode>
    <!-- Image, .map and .framework.json stay in the publish directory; only the
         executable is copied into the C: directory. -->
    <CopperSharpOutputPath Condition="'$(CopperSharpOutputPath)' == ''">$(PublishDir)$(CopperOSCommandName)</CopperSharpOutputPath>
    <CopperOSCDirectory Condition="'$(CopperOSCDirectory)' == ''">$(CopperOSCommandsRoot)..\..\out\C\</CopperOSCDirectory>
  </PropertyGroup>

  <ItemGroup Condition="'$(CopperOSIsHostCommandModel)' != 'true'">
    <Compile Remove="Host\**" />
  </ItemGroup>

  <Import Project="$(CopperSharp68kRoot)\Sdk\Sdk\Sdk.targets"
          Condition="'$(CopperOSIsHostCommandModel)' != 'true' and Exists('$(CopperSharp68kRoot)\Sdk\Sdk\Sdk.targets')" />

  <!-- Sdk.targets points this at its NuGet payload unconditionally; use the
       compiler built from the same local tree instead. Must follow the import. -->
  <PropertyGroup Condition="'$(CopperOSCommandName)' != ''">
    <CopperSharpCompilerAssembly Condition="'$(CopperOSCompilerAssembly)' == ''">$(CopperSharp68kRoot)\Compiler.Cli\bin\Release\net10.0\CopperSharp.Compiler.Cli.dll</CopperSharpCompilerAssembly>
    <CopperSharpCompilerAssembly Condition="'$(CopperOSCompilerAssembly)' != ''">$(CopperOSCompilerAssembly)</CopperSharpCompilerAssembly>
  </PropertyGroup>

  <Target Name="CopperOSCheckCommandToolchain"
          BeforeTargets="PrepareCopperSharpPublishManifest"
          Condition="'$(CopperOSCommandName)' != ''">
    <Error Condition="!Exists('$(CopperSharp68kRoot)\Sdk\Sdk\Sdk.targets')"
           Text="C: commands build against a local CopperSharp68k tree; none found at '$(CopperSharp68kRoot)'. Set CopperSharp68kRoot." />
    <Error Condition="!Exists('$(CopperSharpCompilerAssembly)')"
           Text="CopperSharp compiler not built at '$(CopperSharpCompilerAssembly)'. Run: dotnet build &quot;$(CopperSharp68kRoot)\Compiler.Cli\CopperSharp.Compiler.Cli.csproj&quot; -c Release -p:SkipCopperScreenHeadlessProjectReference=true (or tools\Commands\build-c.ps1)." />
  </Target>

  <!-- Use the compiler's fixed-point peephole mode after fixing data-register
       liveness across unconditional branches in CopperSharp68k. Eval's
       classic-left-shift-word regression passes with this mode on all CPUs.
       Sdk.targets has no typed property for peephole or memory, but the
       compiler's response manifest accepts both keys, so add them to the
       manifest the SDK just wrote. Override CopperOSPeephole/CopperOSMemory
       to select another optimization policy. -->
  <PropertyGroup Condition="'$(CopperOSCommandName)' != ''">
    <CopperOSPeephole Condition="'$(CopperOSPeephole)' == ''">fixed-point</CopperOSPeephole>
    <CopperOSMemory Condition="'$(CopperOSMemory)' == ''">none</CopperOSMemory>
    <!-- No HUNK_SYMBOL block, like the original C: binaries. Kickstart 3.1's
         LoadSeg rejects a symbol name longer than 32 longwords (128 bytes)
         with ERROR_BAD_HUNK, and CopperSharp's mangled names can exceed that
         (Eval: 36 longwords). The .map file next to each image still holds
         the symbols. Set CopperOSSymbols=on to keep them. -->
    <CopperOSSymbols Condition="'$(CopperOSSymbols)' == ''">off</CopperOSSymbols>
    <CopperOSCodeSizeOptimizations Condition="'$(CopperOSCodeSizeOptimizations)' == ''">off</CopperOSCodeSizeOptimizations>
    <CopperOSPythonExecutable Condition="'$(CopperOSPythonExecutable)' == ''">python</CopperOSPythonExecutable>
  </PropertyGroup>

  <Target Name="CopperOSValidateCommandVersion"
          BeforeTargets="PrepareCopperSharpPublishManifest"
          Condition="'$(CopperOSCommandName)' != ''">
    <Error Condition="!Exists('$(CopperOSCommandVersionsFile)')" Text="Command version file not found: $(CopperOSCommandVersionsFile)" />
    <Error Condition="'@(_CopperOSCommandVersion->Count())' != '1'" Text="Expected exactly one version record for $(CopperOSCommandName) in $(CopperOSCommandVersionsFile)." />
    <PropertyGroup>
      <CopperOSBinaryVersion Condition="'$(CopperOSBinaryVersion)' == ''">@(_CopperOSCommandVersion->'%(Version)')</CopperOSBinaryVersion>
      <CopperOSBinaryDate Condition="'$(CopperOSBinaryDate)' == ''">@(_CopperOSCommandVersion->'%(Date)')</CopperOSBinaryDate>
    </PropertyGroup>
    <Error Condition="'$(CopperOSBinaryVersion)' == '' or '$(CopperOSBinaryDate)' == ''" Text="Command $(CopperOSCommandName) needs a version and date." />
  </Target>

  <Target Name="CopperOSExtendPublishManifest"
          AfterTargets="PrepareCopperSharpPublishManifest"
          BeforeTargets="CompileCopperSharpPublishedImage"
          Condition="'$(CopperOSCommandName)' != '' and '$(RuntimeIdentifier)' == 'amiga-m68k'">
    <ReadLinesFromFile File="$(CopperSharpResponseManifestPath)">
      <Output TaskParameter="Lines" ItemName="_CopperOSManifestLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CopperOSManifestLine Remove="@(_CopperOSManifestLine)"
                             Condition="$([System.String]::Copy('%(Identity)').StartsWith('peephole=')) or $([System.String]::Copy('%(Identity)').StartsWith('memory=')) or $([System.String]::Copy('%(Identity)').StartsWith('symbols=')) or $([System.String]::Copy('%(Identity)').StartsWith('code-size-optimizations=')) or $([System.String]::Copy('%(Identity)').StartsWith('code-size-passes='))" />
      <_CopperOSManifestLine Include="peephole=$(CopperOSPeephole)" Condition="'$(CopperOSPeephole)' != ''" />
      <_CopperOSManifestLine Include="memory=$(CopperOSMemory)" Condition="'$(CopperOSMemory)' != ''" />
      <_CopperOSManifestLine Include="symbols=$(CopperOSSymbols)" Condition="'$(CopperOSSymbols)' != ''" />
      <_CopperOSManifestLine Include="code-size-optimizations=$(CopperOSCodeSizeOptimizations)" />
      <_CopperOSManifestLine Include="code-size-passes=$(CopperOSCodeSizePasses)" Condition="'$(CopperOSCodeSizePasses)' != '' and '$(CopperOSCodeSizeOptimizations)' == 'on'" />
    </ItemGroup>
    <WriteLinesToFile File="$(CopperSharpResponseManifestPath)"
                      Lines="@(_CopperOSManifestLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CopperOSCopyToCDirectory"
          AfterTargets="CompileCopperSharpPublishedImage"
          Condition="'$(CopperOSCommandName)' != '' and '$(RuntimeIdentifier)' == 'amiga-m68k'">
    <Copy SourceFiles="$(CopperSharpOutputPath)"
          DestinationFiles="$(CopperOSCDirectory)$(CopperOSCommandName)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(CopperOSCommandName) -> $([System.IO.Path]::GetFullPath('$(CopperOSCDirectory)$(CopperOSCommandName)'))" />
  </Target>
  <!-- Every published command carries a searchable, NUL-terminated Amiga
       $VER identifier. The bounded appender preserves CODE, relocations and
       symbols; the final command copy happens only after it succeeds. -->
  <Target Name="CopperOSAppendCommandVersion"
          AfterTargets="CompileCopperSharpPublishedImage"
          BeforeTargets="CopperOSCopyToCDirectory"
          Condition="'$(CopperOSCommandName)' != '' and '$(RuntimeIdentifier)' == 'amiga-m68k'">
    <GetFileHash Files="$(CopperSharpOutputPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CopperOSRawHunk" />
    </GetFileHash>
    <Delete Files="$(CopperSharpOutputPath).versioned;$(CopperSharpOutputPath).version-receipt.json" />
    <Exec Command="&quot;$(CopperOSPythonExecutable)&quot; &quot;$(MSBuildThisFileDirectory)..\..\tools\Commands\append_hunk_version.py&quot; --input &quot;$(CopperSharpOutputPath)&quot; --input-sha256 &quot;$([System.String]::Copy('%(_CopperOSRawHunk.FileHash)').ToLowerInvariant())&quot; --output &quot;$(CopperSharpOutputPath).versioned&quot; --receipt &quot;$(CopperSharpOutputPath).version-receipt.json&quot; --version &quot;$VER: $(CopperOSCommandName) $(CopperOSBinaryVersion) ($(CopperOSBinaryDate)) CopperOS&quot;" />
    <Copy SourceFiles="$(CopperSharpOutputPath).versioned"
          DestinationFiles="$(CopperSharpOutputPath)"
          OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
