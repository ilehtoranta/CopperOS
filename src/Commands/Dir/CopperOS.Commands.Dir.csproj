<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CopperOS.Commands.Dir</AssemblyName>
    <RootNamespace>CopperOS.Commands</RootNamespace>
    <RuntimeIdentifier>amiga-m68k</RuntimeIdentifier>
    <CopperOSCommandName>Dir</CopperOSCommandName>
    <CopperOSCodeSizeOptimizations Condition="'$(CopperOSCodeSizeOptimizations)' == ''">on</CopperOSCodeSizeOptimizations>
    <DefineConstants Condition="'$(CopperOSSpecializeWorkbench31)' != 'false'">$(DefineConstants);COPPEROS_WORKBENCH31_DIR</DefineConstants>
    <CopperSharpEntry>CopperOS.Commands.Entries.DirEntry::Main</CopperSharpEntry>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\CopperOS.Commands.Common.csproj" />
    <ProjectReference Include="..\Search\CopperOS.Commands.Search.csproj" />
  </ItemGroup>
</Project>
