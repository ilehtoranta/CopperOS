<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\CopperOS.Portable.props" />
  <PropertyGroup>
    <AssemblyName>CopperOS.MuiMaster</AssemblyName>
    <RootNamespace>CopperOS.MuiMaster</RootNamespace>
    <ImplicitUsings>false</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CopperSharpSdkHasMuiLayoutPackets)' == 'true' or ('$(CopperOSUseLocalCopperSharp)' == 'true' and Exists('$(CopperSharp68kRoot)\Sdk.Amiga\CopperSharp.Sdk.Amiga.csproj'))">
    <DefineConstants>$(DefineConstants);COPPEROS_SDK_MUI_LAYOUT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CopperOSUseLocalCopperSharp)' == 'true'">
    <ProjectReference Include="$(CopperSharp68kRoot)\Sdk.Amiga.Support\CopperSharp.Sdk.Amiga.Support.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(CopperOSUseLocalCopperSharp)' != 'true'">
    <PackageReference Include="CopperSharp.Sdk.Amiga.Support" Version="$(CopperSharpSdkAmigaVersion)" />
  </ItemGroup>
</Project>
