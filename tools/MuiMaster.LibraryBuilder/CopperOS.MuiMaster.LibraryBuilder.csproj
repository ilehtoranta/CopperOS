<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CopperOSUseLocalCopperSharp>true</CopperOSUseLocalCopperSharp>
    <CopperSharp68kRoot Condition="'$(CopperSharp68kRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\CopperSharp68k</CopperSharp68kRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <ProjectReference Include="..\..\src\Libraries\muimaster.library\CopperOS.MuiMaster.csproj" AdditionalProperties="CopperOSUseLocalCopperSharp=true" />
    <ProjectReference Include="$(CopperSharp68kRoot)\Targets.Amiga\CopperSharp.Targets.Amiga.csproj" />
  </ItemGroup>
</Project>
