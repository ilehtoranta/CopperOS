<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireFrozenRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FrozenRuntimeDirectory)' == ''" Text="Supply FrozenRuntimeDirectory pointing to an exact qualified CopperStart replay runtime." />
  </Target>
  <ItemGroup>
    <Reference Include="$(FrozenRuntimeDirectory)/Copper*.dll" Exclude="$(FrozenRuntimeDirectory)/*Tests.dll" />
  </ItemGroup>
</Project>
